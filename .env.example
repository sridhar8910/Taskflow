# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string used by the FastAPI app (async driver)
DATABASE_URL=postgresql+asyncpg://taskflow:taskflow@db:5432/taskflow

# Sync version used by Celery workers (no asyncpg)
SYNC_DATABASE_URL=postgresql+psycopg2://taskflow:taskflow@db:5432/taskflow

# ── Redis ─────────────────────────────────────────────────────────────────────
# Used for both the cache and the Celery broker/result-backend
REDIS_URL=redis://redis:6379/0

# Celery-specific broker and result backend (can point to the same Redis)
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ── Auth ──────────────────────────────────────────────────────────────────────
# Long random string — change this before any real deployment
SECRET_KEY=change-me-to-a-long-random-string-before-deploying

# How many minutes until an access token expires
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Cache ─────────────────────────────────────────────────────────────────────
# TTL in seconds for cached task-list responses
CACHE_TTL_SECONDS=60

# ── App ───────────────────────────────────────────────────────────────────────
# Set to "production" in deployed environments
APP_ENV=development
